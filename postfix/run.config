#!/bin/bash -e

postconf -e 'smtpd_sasl_auth_enable = yes'
postconf -e 'smtpd_sasl_type = cyrus'
postconf -e 'smtpd_sasl_path = smtpd'
postconf -e 'smtpd_sasl_security_options = noanonymous'
postconf -e 'broken_sasl_auth_clients = yes'

# Log mail events to stdout (useful for debugging in containers)
postconf -e 'maillog_file = /dev/stdout'

# Cyrus SASL uses /etc/sasldb2 by default. When smtpd runs chrooted (common default),
# it cannot read /etc/sasldb2 and AUTH will always fail. Disable chroot for smtpd.
postconf -F 'smtp/inet/chroot=n'

# Allow AUTH without TLS (only inside docker network). If you want to enforce TLS, change to yes and use port 587.
postconf -e 'smtpd_tls_auth_only = no'

# Only authenticated clients may relay to non-local domains.
# Keep defer_unauth_destination to still accept mail to mydestination.
postconf -e 'smtpd_relay_restrictions = permit_sasl_authenticated, defer_unauth_destination'
